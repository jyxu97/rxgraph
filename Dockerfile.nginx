# nginx + React frontend image (multi-stage build)
# Build from project root:
#   docker build -f Dockerfile.nginx -t rxgraph-frontend .
#
# Stage 1: build the React app
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
# REACT_APP_API_URL="" causes axios to use relative URLs (/api/...)
# so nginx can proxy them to the FastAPI container on the same host.
ENV REACT_APP_API_URL=
RUN npm run build

# Stage 2: serve with nginx
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
